# Golden Ghost V36
# Render/Railway normally provide PORT automatically. Do not commit secrets.
NODE_ENV=production
PORT=10000
# Optional at startup; recommended in cloud for stable sessions across restarts.
SESSION_SECRET=
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=86400000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-private
APP_BASE_URL=
RESEND_API_KEY=
MAIL_FROM=Golden Ghost <onboarding@resend.dev>
DEV_EMAIL_MODE=false
PAYMENT_PROVIDER=unconfigured
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=
