{
  "name": "Golden Ghost \u2014 One Community. One World.",
  "short_name": "Golden Ghost",
  "description": "Golden Ghost unified cross-device community and membership platform",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#050505",
  "theme_color": "#ffd21f",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "id": "/",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ]
}
